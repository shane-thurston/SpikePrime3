def obstacle_found():
    #Include the obstacle found code here

async def avoid_obstacle():
    await runloop.sleep_ms(500)
    await spin_turn(90, 200)
    #complete the function to get around the obstacle

async def line_follow_forever():
    while (True):
        if obstacle_found():
            motor_pair.stop(motor_pair.PAIR_1)
            runloop.run(avoid_obstacle())
        else:
            if (color_sensor.reflection(port.E) < 65): # sensor is on Black. Lower threshold as needed for your case.
                # Turn right, i.e. away from Black
                motor_pair.move(motor_pair.PAIR_1, 55, velocity = 300)
            else: # sensor is on white
                # Turn left, i.e. towards Black
                motor_pair.move(motor_pair.PAIR_1, -55, velocity = 300)

async def main():
    await line_follow_forever()

runloop.run(main())
